{
  "name": "vscode-dungeon-coder",
  "displayName": "Dungeon Coder",
  "description": "Code to escape the dungeon",
  "extensionKind": [
    "ui"
  ],
  "publisher": "hm-benidiet",
  "author": {
    "name": "Munich University of Applied Sciences",
    "email": "benedikt.dietrich@hm.edu"
  },
  "license": "MIT",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.102.0"
  },
  "icon": "game/assets/images/dungeon_coder_icon.png",
  "categories": [
    "Other"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hm-benidiet/vscode-dungeon-coder"
  },
  "bugs": {
    "url": "https://github.com/hm-benidiet/vscode-dungeon-coder/issues"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-dungeon-coder.startGame",
        "title": "Dungeon Coder: Enter the dungeon"
      },
      {
        "command": "vscode-dungeon-coder.copyPythonAPI",
        "title": "Dungeon Coder: Copy Python API to workspace"
      },
      {
        "command": "vscode-dungeon-coder.loadLevel",
        "title": "Dungeon Coder: Load level into the game",
        "icon": "$(play)"
      },
      {
        "command": "vscode-dungeon-coder.runOnAllLevels",
        "title": "Dungeon Coder: Run program on all levels (simulator)",
        "icon": "$(run-all)"
      },
      {
        "command": "vscode-dungeon-coder.replayTrace",
        "title": "Dungeon Coder: Replay trace in the game"
      },
      {
        "command": "vscode-dungeon-coder.refreshLevels",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Dungeon Coder",
      "properties": {
        "dungeonCoder.assetPacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Folders with asset packs (tilesets, images). They are searched before the pictures that come with the extension. Relative paths start at the workspace folder."
        },
        "dungeonCoder.port": {
          "type": "number",
          "default": 3000,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port of the game's local API. Change it (e.g. to 3001) to run next to another Dungeon Coder; Python scripts in the workspace find it automatically (.dungeoncoder-port)."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "dungeonCoder.levels",
          "name": "Dungeon Coder Levels"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vscode-dungeon-coder.refreshLevels",
          "when": "view == dungeonCoder.levels",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-dungeon-coder.loadLevel",
          "when": "view == dungeonCoder.levels && viewItem == dungeonCoderLevel",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "vscode-dungeon-coder.runOnAllLevels",
          "when": "resourceLangId == python",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "vscode-dungeon-coder.replayTrace",
          "when": "resourceFilename =~ /\\.trace\\.json$/"
        },
        {
          "command": "vscode-dungeon-coder.loadLevel",
          "when": "resourceExtname == .json || resourceExtname == .txt"
        }
      ],
      "commandPalette": [
        {
          "command": "vscode-dungeon-coder.refreshLevels",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "generate:commands": "node tools/generate-commands.mjs",
    "generate:types": "openapi-typescript api/openapi.yaml -o src/generated/api-types.d.ts",
    "generate:api-config": "node tools/generate-api-config.mjs",
    "generate": "npm run generate:commands && npm run generate:types && npm run generate:api-config",
    "generate:python-client": "bash tools/generate-python-client.sh",
    "compile": "npm run generate && webpack",
    "watch": "npm run generate && webpack --watch",
    "package": "npm run generate && webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src game/src game/test tools",
    "test:engine": "node --test game/test/engine.test.mjs",
    "test:tools": "python3 tools/levels/test_level_tools.py",
    "learn:styles": "python3 tools/levels/learn_styles.py",
    "test": "vscode-test",
    "test:download": "node -e \"require('@vscode/test-electron').downloadAndUnzipVSCode({cachePath: require('os').homedir() + '/.cache/vscode-test', version: '1.140.0'}).then(console.log)\"",
    "dev:browser": "npm run generate:commands && node tools/dev-server.mjs",
    "check:version": "node tools/check-version.mjs",
    "build:wheel": "npm run generate:api-config && npm run check:version && python3 -m pip wheel --no-deps -w out/wheel api/python"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/node-fetch": "^2.6.12",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "js-yaml": "^5.4.1",
    "openapi-typescript": "^7.13.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-openapi-validator": "^5.6.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  }
}
