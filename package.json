{
  "name": "vscode-dungeon-coder",
  "displayName": "Dungeon Coder",
  "description": "Code to escape the dungeon",
  "extensionKind": [
    "ui"
  ],
  "publisher": "hm-benidiet",
  "author": {
    "name": "Munich University of Applied Sciences",
    "email": "benedikt.dietrich@hm.edu"
  },
  "license": "MIT",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.102.0"
  },
  "icon": "game/assets/images/dungeon_coder_icon.png",
  "categories": [
    "Other"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hm-benidiet/vscode-dungeon-coder"
  },
  "bugs": {
    "url": "https://github.com/hm-benidiet/vscode-dungeon-coder/issues"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-dungeon-coder.startGame",
        "title": "Dungeon Coder: Enter the dungeon"
      },
      {
        "command": "vscode-dungeon-coder.copyPythonAPI",
        "title": "Dungeon Coder: Copy Python API to workspace"
      }
    ],
    "configuration": {
      "title": "Dungeon Coder",
      "properties": {
        "dungeonCoder.assetPacks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Folders with asset packs (tilesets, images). They are searched before the pictures that come with the extension. Relative paths start at the workspace folder."
        },
        "dungeonCoder.port": {
          "type": "number",
          "default": 3000,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Port of the game's local API. Change it (e.g. to 3001) to run next to another Dungeon Coder; Python scripts in the workspace find it automatically (.dungeoncoder-port)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "generate:commands": "node tools/generate-commands.mjs",
    "generate:types": "openapi-typescript api/openapi.yaml -o src/generated/api-types.d.ts",
    "generate:api-config": "node tools/generate-api-config.mjs",
    "generate": "npm run generate:commands && npm run generate:types && npm run generate:api-config",
    "generate:python-client": "bash tools/generate-python-client.sh",
    "compile": "npm run generate && webpack",
    "watch": "npm run generate && webpack --watch",
    "package": "npm run generate && webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src game/src tools",
    "test": "vscode-test",
    "dev:browser": "npm run generate:commands && node tools/dev-server.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/node-fetch": "^2.6.12",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "js-yaml": "^5.4.1",
    "openapi-typescript": "^7.13.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-openapi-validator": "^5.6.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  }
}
